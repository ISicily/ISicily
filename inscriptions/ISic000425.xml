                                    <dimensions>
                                        <height unit="cm">21.5</height>
                                        <width unit="cm">25.5</width>
                                        <depth unit="cm">3.7 (base) - 4.3 (top)</depth>
                                    </dimensions>
                                </support>
                                <condition ana="#condition.fragment"/>
		    </supportDesc>
                            <layoutDesc>
                                <layout><p>Parts of three lines of large Latin letters, decreasing in height from top to bottom.</p>
                                    <rs ana="#execution.chiselled" ref="http://www.eagle-network.eu/voc/writing/lod/1">chiselled</rs>
                                    <rs ana="#execution.rubrication.red">rubrication, red</rs>
