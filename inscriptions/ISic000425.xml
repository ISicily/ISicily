                    <physDesc>
                        <objectDesc>
                            <supportDesc>
                                <support><p>Large fragment of a thick slab of white marble. Seemingly intact on left (but chipped/damaged) and lower edge; broken across top and on the right. Lower edge is cut back from the front face. Rear is finished smooth.</p>
                                    <material ana="#material.inorganic.stone" type="stone.unspecified" subtype="unspecified" resp="#Coccato" ref="http://www.eagle-network.eu/voc/material/lod/48.html">marble</material>
