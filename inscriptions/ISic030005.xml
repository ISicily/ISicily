                <ab>
                    <lb n="1"/>Σελιν<supplied reason="omitted">ό</supplied>ντιος <supplied reason="lost">
                    <lb n="2"/>κ</supplied><unclear>α</unclear>ὶ ͱα Σελινο
                    <lb n="3" break="no"/>ντίο̄ γλο͂σα ἀπεσ
                    <lb n="4" break="no"/>τραμέν’ ἐπ’ ἀτ<supplied reason="omitted">ε</supplied>λ
                    <lb n="5" break="no"/>είαι τᾶι τέ̄|ν|ο̄ν | ἐν|γράφο̄
                    <lb n="6"/>καὶ το͂ν ξένο̄ν συν
                    <lb n="7" break="no"/>δίϙο̄ν τὰς γλό̄σας ἀπε
                    <lb n="8" break="no"/>στραμένας ἐπ’ ἀτε
                    <lb n="9" break="no"/>λείαι τᾶι τέ̄νο̄ν
                    <lb n="10"/>ἐνγρ<unclear>ά</unclear>φο̄
                </ab>
                </div>
                  <div type="textpart" subtype="face" n="b">
                <ab>
                    <lb n="1"/>Τιμασὸ̄ι καὶ ͱα Τιμασο͂ς γλο͂σσα <supplied reason="lost">ἀ</supplied>πεστραμέ
                    <lb n="2" break="no"/>ναν ἐπ’ ἀτελείαι τᾶι τέ̄νο̄ν ἐ<supplied reason="omitted">ν</supplied>γράφο̄
                    <lb n="3"/>Τυρρανὰ καὶ ͱα <supplied reason="lost">Τυρρ</supplied>ανᾶς γλο͂σα <supplied reason="lost">ἀπε</supplied>στρ
                    <lb n="4" break="no"/>αμέναν ἐπ’ ἀτελείαι τ<supplied reason="lost">ᾶι</supplied> <supplied reason="lost">τ</supplied>έ̄νο̄ν ἐ<supplied reason="omitted">ν</supplied>γ<supplied reason="lost">ράφο̄</supplied> πάντο̄ν
                </ab>
